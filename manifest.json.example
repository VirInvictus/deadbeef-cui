{
    "supported_platforms": ["linux"],
    "source": {
        "type": "git",
        "url": "https://github.com/VirInvictus/deadbeef-cui.git"
    },
    "cmake": {
        "root": "/",
        "ENV": {
            "GTK3_CFLAGS": "$GTK310_CFLAGS",
            "GTK3_LIBS": "$GTK310_LIBS"
        },
        "out": [
            "ddb_misc_cui_GTK3.so"
        ]
    }
}
